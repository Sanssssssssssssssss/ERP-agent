#!/bin/bash
# Harbor oracle solution script for {{ scenario_name }}

set -eo pipefail

echo "=== Executing Optimal Solution ==="
echo "Scenario: {{ scenario_number }} - {{ scenario_name }}"

for _ in $(seq 1 180); do
    if [ -f /tmp/saas_setup_complete ] && curl -sf "http://127.0.0.1:8069/web/database/selector" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! [ -f /tmp/saas_setup_complete ]; then
    echo "Setup marker not found; environment initialization is incomplete"
    exit 1
fi

# Install dependencies
uv pip install --system -q "odoo-client-lib==2.0.2" 2>/dev/null || true

# Execute the optimal plan via JSON-2 API
python3 /solution/solver.py

echo ""
echo "=== Solution Summary ==="
echo "Total revenue: \${{ '%.2f' | format(plan.total_revenue) }}"
echo "Total cost: \${{ '%.2f' | format(plan.total_cost) }}"
echo "Accounting margin: {{ '%.1f' | format(plan.margin * 100) }}%"
echo "Required new-spend margin: {{ '%.1f' | format(required_new_spend_margin * 100) }}%"
echo "Spend-backed revenue: \${{ '%.2f' | format(plan.revenue_from_new_spend) }}"
echo "New spend: \${{ '%.2f' | format(plan.expected_new_spend) }}"
{% if plan.new_spend_margin is not none %}
echo "Actual new-spend margin: {{ '%.1f' | format(plan.new_spend_margin * 100) }}%"
{% else %}
echo "Actual new-spend margin: n/a (no new spend)"
{% endif %}
