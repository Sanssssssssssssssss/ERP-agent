version = "1.0"

[metadata]
scenario_number = {{ scenario_number }}
name = "{{ scenario_name }}"
difficulty = "{{ difficulty }}"
category = "{{ category }}"
{% if objective_kind is defined and objective_kind is not none %}
objective_kind = "{{ objective_kind }}"
{% endif %}
{% if task_pattern is not none %}
task_pattern = "{{ task_pattern }}"
{% endif %}
tags = [{% for tag in tags %}"{{ tag }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% if seed is not none %}
seed = {{ seed }}
{% endif %}

[verifier]
timeout_sec = 300.0

[agent]
timeout_sec = 3600.0

[environment]
build_timeout_sec = {{ build_timeout_sec | default(600.0) }}
cpus = {{ cpus | default(3) }}
memory_mb = {{ memory_mb | default(4096) }}
storage_mb = {{ storage_mb | default(2048) }}
